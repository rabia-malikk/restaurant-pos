# true  = run entirely on in-browser demo data (no backend needed)
# false = talk to the real backend at VITE_API_URL
VITE_USE_MOCK=true

# Base URL of the REST API (proxied to http://localhost:3000 by Vite in development)
VITE_API_URL=/api

# Socket.IO server origin. Leave empty to use the page's own origin.
VITE_SOCKET_URL=

# Display settings
VITE_CURRENCY=PKR
VITE_TAX_PERCENT=0
