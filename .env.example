# Base URL of the REST API (proxied to http://localhost:3000 by Vite in development)
VITE_API_URL=/api

# Socket.IO server origin. Leave empty to use the page's own origin.
VITE_SOCKET_URL=

# Server-only MySQL settings. Never expose these as VITE_ variables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hawt_pos
DB_USER=pos_app
DB_PASSWORD=replace-with-your-local-database-password
API_PORT=3000

# Display settings
VITE_CURRENCY=PKR
VITE_TAX_PERCENT=0
